# Postgres connection string. If deploying on Vercel, add the free Neon
# Postgres integration from your Vercel project and it will set this for you
# automatically as DATABASE_URL (or POSTGRES_PRISMA_URL - see README).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."
